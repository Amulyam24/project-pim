FROM quay.io/<account-id>/pim:base-rocm

# 1. Install the build-time system packages required for ppc64le wheel compilation
RUN dnf install -y \
    make \
    cmake \
    rust \
    cargo \
    libffi-devel \
    openssl-devel \
    libjpeg-turbo-devel \
    libpng-devel \
    zlib-devel \
    libomp \
    libomp-devel \
    numactl-libs \
    git \
    wget && \
    dnf clean all

# 2. Stage all remaining custom wheels from your host directory
RUN mkdir -p /tmp/wheels
COPY ./custom-rocm/triton*.whl \
     ./custom-rocm/torch*.whl \
     ./custom-rocm/vllm*.whl \
     /tmp/wheels/

# 3. Install PyTorch runtime dependencies using the specialized IBM ppc64le index
RUN /usr/local/vllm-venv/bin/pip install --no-cache-dir \
    --extra-index-url=https://wheels.developerfirst.ibm.com/ppc64le/linux \
    numpy \
    pillow \
    filelock \
    typing-extensions \
    sympy \
    networkx \
    jinja2 \
    fsspec

# 4. Install PyTorch wheels with --no-deps to mirror your exact UBI design
RUN /usr/local/vllm-venv/bin/pip install --no-cache-dir --no-deps \
    /tmp/wheels/torch-*.whl \
    /tmp/wheels/torchvision-*.whl \
    /tmp/wheels/torchaudio-*.whl

# 5. Install Triton wheel
RUN /usr/local/vllm-venv/bin/pip install --no-cache-dir \
    /tmp/wheels/triton-*.whl

# 6. Install vLLM runtime dependencies
RUN /usr/local/vllm-venv/bin/pip install --no-cache-dir \
    prometheus-client \
    ninja \
    einops \
    gguf \
    cloudpickle \
    diskcache \
    'lark==1.2.2' \
    cachetools \
    blake3 \
    setproctitle \
    six \
    pyzmq \
    python-json-logger \
    timm \
    pybase64 \
    protobuf \
    watchfiles \
    ijson \
    prometheus-fastapi-instrumentator \
    uvloop \
    openai \
    anthropic \
    fastapi \
    python-multipart \
    sentencepiece \
    uvicorn \
    partial-json-parser \
    transformers \
    huggingface-hub \
    tokenizers \
    pydantic \
    requests \
    'llguidance>=1.3.0,<1.4.0' \
    'xgrammar>=0.1.32,<1.0.0' \
    'opencv-python-headless==4.12.0.88'

# 7. Install the final vLLM target wheel with --no-deps
RUN /usr/local/vllm-venv/bin/pip install --no-cache-dir --no-deps \
    /tmp/wheels/vllm-*.whl

# Clean up build artifacts
RUN rm -rf /tmp/wheels

# 8. Set up interactive environment variables for SSH sessions on the bare-metal machine
RUN echo 'export PATH="/usr/local/vllm-venv/bin:/opt/rocm/bin:$PATH"' > /etc/profile.d/vllm.sh && \
    echo 'export LD_LIBRARY_PATH="/usr/local/vllm-venv/lib/python3.12/site-packages/_rocm_sdk_core/lib:/usr/local/vllm-venv/lib/python3.12/site-packages/torch/lib:$LD_LIBRARY_PATH"' >> /etc/profile.d/vllm.sh && \
    echo 'export PYTHONPATH="/usr/local/vllm-venv/lib64/python3.12/site-packages/_rocm_sdk_core/share/amd_smi:$PYTHONPATH"' >> /etc/profile.d/vllm.sh

# 9. Inject and activate the systemd runtime orchestration service
COPY vllm-rocm.service /etc/systemd/system/vllm-rocm.service
RUN systemctl enable vllm-rocm.service

# 10. Final Bootc System Verification
RUN bootc container lint
