# Fedora 44 bootc base — ships the amdgpu kernel patches natively,
# no custom kernel replacement needed.
FROM quay.io/fedora/fedora-bootc:44

 # check if modules are loaded

# 1. Install Python 3.12 runtime and build essentials.
#    Fedora 44 defaults to Python 3.13; we pin 3.12 explicitly because all
#    ROCm/torch/vllm wheels and the venv paths in vllm-rocm.service reference python3.12.
RUN dnf install -y python3.12 python3.12-devel gcc gcc-c++ && dnf clean all

# 2. Create a system-wide virtual environment locked to Python 3.12
RUN python3.12 -m venv /usr/local/vllm-venv && \
    /usr/local/vllm-venv/bin/pip install --no-cache-dir --upgrade pip setuptools wheel

# 3. Install ROCm platform SDK wheels into the venv.
#    rocm*.whl matches rocm-*.whl and rocm_sdk_*-*.whl but excludes
#    torch/triton/vllm wheels that live in the same source directory.
RUN mkdir -p /tmp/rocm
COPY ./custom-rocm/rocm*.whl /tmp/rocm/

RUN /usr/local/vllm-venv/bin/pip install --no-cache-dir /tmp/rocm/rocm*.whl

RUN rm -rf /tmp/rocm

# 4. Install cloud-init (required by PIM base_config.service for network and user setup)
RUN dnf -y install cloud-init && \
    ln -s ../cloud-init.target /usr/lib/systemd/system/default.target.wants && \
    rm -rf /var/{cache,log} /var/lib/{dnf,rhsm}
COPY usr/ /usr/

# 5. Wire up PIM base config service (mounts cloud-init ISO, copies pim_config.json and auth.json)
COPY base_config.sh /usr/bin/
COPY base_config.service /etc/systemd/system
RUN systemctl unmask base_config.service
RUN systemctl enable base_config.service

# 6. Verify the boot configuration
RUN bootc container lint
